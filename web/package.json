{
  "name": "shentarot-web",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-art.mjs && node scripts/og-cards.mjs",
    "predev": "node scripts/copy-art.mjs && node scripts/og-cards.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy && node scripts/indexnow.mjs",
    "test": "node --test tests/*.test.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:reader-build": "node scripts/check-reader-build.mjs",
    "check:ritual-build": "node scripts/check-ritual-build.mjs",
    "postbuild": "node scripts/release-manifest.mjs && node scripts/agent-markdown.mjs",
    "check:interactions-build": "node scripts/check-interactions-build.mjs",
    "check:search-growth-build": "node scripts/check-search-growth-build.mjs",
    "check:beta-build": "node scripts/check-beta-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.2",
    "linkedom": "^0.18.14",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
