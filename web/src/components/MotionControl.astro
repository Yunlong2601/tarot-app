---
import type { i18n } from '../i18n/index';
interface Props { L: ReturnType<typeof i18n> }
const { L } = Astro.props;
const I = L.interactions;
---
<button class="motion-toggle" type="button" data-motion-toggle data-full={I.motionOn} data-reduced={I.motionOff} aria-pressed="false" hidden>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none"><path d="M2 10h4l3-6 3 12 3-6h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span>{I.motion}: <span data-motion-state>{I.motionOn}</span></span>
</button>
