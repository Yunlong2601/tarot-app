  chat: "M4 5.5h16v10H9l-5 4v-14zM8 9.5h8M8 12.5h5",
  layout: "M3.5 6h5v8h-5zM9.5 4h5v8h-5zM15.5 6h5v8h-5zM9.5 14.5h5V20h-5z",
  book: "M5 4.5h9a3 3 0 013 3v12H8a3 3 0 01-3-3zM5 16.5a3 3 0 013-3h9M9 8.5h5",
