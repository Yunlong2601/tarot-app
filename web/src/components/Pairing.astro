---
// Pick cards (or draw them) and see how they read together. "combine" shows
// two cards and what links them; "elements" checks the elemental dignities of
// a line of two or three cards. Nothing leaves the page.
import { BASE } from "../config.ts";
import { readerDeck } from "../lib/data.ts";

interface Props {
  mode: "combine" | "elements";
  slots: string[];
}
const { mode, slots } = Astro.props;
const config = JSON.stringify({ mode, slots, base: BASE, deck: readerDeck });
---
<div class="pairing" data-pairing>
  <script type="application/json" data-config set:html={config.replace(/</g, "\\u003c")} />
  <div class="panel tool-panel picker">
    {slots.map((s, i) => (
      <div class="pick">
        <label>{s}
          <select data-card={i}>
            <option value="">{i === 2 ? "None" : "Choose a card"}</option>
            {readerDeck.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
        </label>
        {mode === "combine" && <label class="check"><input type="checkbox" data-rev={i} /> Reversed</label>}
      </div>
    ))}
    <p class="center actions">
      <button class="btn btn-gold" type="button" data-random>Draw at random</button>
    </p>
  </div>
  <div data-out aria-live="polite"></div>
</div>

<script>
  type Card = { id: string; slug: string; name: string; suit: string | null; n: number | null; keywords: string[]; up: string; rev: string; upQ: string; revQ: string; el: string | null };
  type Config = { mode: "combine" | "elements"; slots: string[]; base: string; deck: Card[] };

  const rand = (n: number) => {
    const r = new Uint32Array(1);
    crypto.getRandomValues(r);
    return r[0]! % n;
  };
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };
  const NUMBER_WORD = ["", "Aces", "Twos", "Threes", "Fours", "Fives", "Sixes", "Sevens", "Eights", "Nines", "Tens"];
  const SUIT_SENSE: Record<string, string> = { wands: "drive and action", cups: "feelings and relationships", swords: "thoughts and conflict", pentacles: "work, money and the body" };
  const COURT = ["page", "knight", "queen", "king"];
  const isCourt = (c: Card) => c.suit !== null && c.n === null;
  const courtRank = (c: Card) => COURT.find((r) => c.id.endsWith(`_${r}`)) ?? "";

  // Elemental dignities as the Golden Dawn tradition reads them: the same
  // element strengthens, opposite elements (Fire and Water, Air and Earth)
  // weaken each other, and the rest support each other.
  type Rel = "same" | "friendly" | "contrary" | "neutral";
  function relation(a: string | null, b: string | null): Rel {
    if (!a || !b) return "neutral";
    if (a === b) return "same";
    const pair = [a, b].sort().join("+");
    return pair === "Fire+Water" || pair === "Air+Earth" ? "contrary" : "friendly";
  }
  const REL_TEXT: Record<Rel, string> = {
    same: "share an element, so they strengthen each other",
    friendly: "have friendly elements, so they support each other",
    contrary: "have opposite elements, so they weaken each other",
    neutral: "neither help nor hinder each other, because one has no single element",
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-pairing]")) {
    const cfg = JSON.parse(root.querySelector("[data-config]")!.textContent!) as Config;
    const selects = [...root.querySelectorAll<HTMLSelectElement>("[data-card]")];
    const revs = [...root.querySelectorAll<HTMLInputElement>("[data-rev]")];
    const out = root.querySelector<HTMLElement>("[data-out]")!;
    const bySlug = new Map(cfg.deck.map((c) => [c.slug, c]));

    function chosen() {
      return selects.map((s, i) => ({ card: bySlug.get(s.value), reversed: !!revs[i]?.checked }));
    }

    function face(card: Card, reversed: boolean, label: string) {
      const spot = el("div", "spot");
      spot.append(el("p", "pos", label));
      const box = el("div", "face");
      const link = el("a");
      link.href = `${cfg.base}cards/${card.slug}`;
      const img = el("img", reversed ? "rev" : "");
      img.src = `${cfg.base}cards/art/${card.id}.jpg`;
      img.alt = `${card.name}${reversed ? ", reversed" : ""}`;
      img.width = 300;
      img.height = 514;
      link.append(img);
      const body = el("div", "face-body");
      body.append(el("b", "", card.name + (reversed ? " (reversed)" : "")));
      if (cfg.mode === "elements") body.append(el("p", `elem ${(card.el ?? "none").toLowerCase()}`, card.el ?? "Planet: no single element"));
      body.append(el("p", "kw", card.keywords.join(" · ")));
      if (cfg.mode === "combine") body.append(el("p", "", reversed ? card.rev : card.up));
      const more = el("a", "link-arrow", "Full meaning");
      more.href = link.href;
      body.append(more);
      box.append(link, body);
      spot.append(box);
      return spot;
    }

    function combineNotes(a: Card, ar: boolean, b: Card, br: boolean) {
      const lines: string[] = [];
      const am = a.suit === null, bm = b.suit === null;
      if (am && bm) lines.push(`Two Major Arcana: one big theme seen from two sides. Ask what ${a.name} and ${b.name} have in common, and where they pull apart.`);
      else if (am || bm) {
        const [m, x] = am ? [a, b] : [b, a];
        lines.push(`${m.name} sets the theme; ${x.name} shows where it plays out day to day.`);
      } else if (a.suit === b.suit) lines.push(`Both are ${a.suit}: the whole question sits in ${SUIT_SENSE[a.suit!]}.`);
      else lines.push(`${a.suit![0]!.toUpperCase()}${a.suit!.slice(1)} meet ${b.suit}: ${SUIT_SENSE[a.suit!]} meets ${SUIT_SENSE[b.suit!]}.`);
      if (!am && !bm && a.n !== null && a.n === b.n) lines.push(`Both are ${NUMBER_WORD[a.n]}: the same stage of a story is showing up in two parts of life.`);
      if (am && bm && a.n !== null && b.n !== null && Math.abs(a.n - b.n) === 1) lines.push("They sit next to each other in the Major Arcana, so one may be the step that leads to the other.");
      const courts = [a, b].filter(isCourt);
      if (courts.length === 2) lines.push(courtRank(a) === courtRank(b) ? `Two ${courtRank(a)}s: two people, or two sides of you, acting in a similar way.` : "Two court cards: often two people in the situation, or two ways you could act.");
      else if (courts.length === 1) lines.push(`${courts[0]!.name} often stands for a person, or a way of acting, in the situation the other card describes.`);
      if (ar && br) lines.push("Both reversed: the energy of both cards is blocked, delayed or turned inward. Ask what is holding it back.");
      else if (ar || br) lines.push(`${ar ? a.name : b.name} is reversed: one part flows while the other is blocked or turned inward.`);
      const r = relation(a.el, b.el);
      if (a.el && b.el) lines.push(`Elements: ${a.name} (${a.el}) and ${b.name} (${b.el}) ${REL_TEXT[r]}.`);
      return lines;
    }

    function elementNotes(cards: Card[]) {
      const lines: string[] = [];
      for (let i = 0; i < cards.length - 1; i++) {
        const [x, y] = [cards[i]!, cards[i + 1]!];
        lines.push(`${x.name} and ${y.name} ${REL_TEXT[relation(x.el, y.el)]}.`);
      }
      if (cards.length === 3) {
        const [l, m, r] = cards as [Card, Card, Card];
        const rels = [relation(l.el, m.el), relation(m.el, r.el)];
        const good = rels.filter((x) => x === "same" || x === "friendly").length;
        const bad = rels.filter((x) => x === "contrary").length;
        let verdict: string;
        if (bad === 2) verdict = `${m.name} is much weakened: both neighbours oppose it. Read it lightly, as a smaller influence.`;
        else if (bad === 1 && good === 1) verdict = `${m.name} is mixed: one neighbour supports it and one opposes it.`;
        else if (bad === 1) verdict = `${m.name} is somewhat weakened by one opposing neighbour.`;
        else if (good === 2) verdict = `${m.name} is strengthened: both neighbours support it. Read it as a strong influence.`;
        else if (good === 1) verdict = `${m.name} is somewhat strengthened by one supporting neighbour.`;
        else verdict = `${m.name} is neither helped nor hindered by its neighbours.`;
        lines.push(verdict);
        if (relation(l.el, r.el) === "contrary" && rels.every((x) => x === "friendly" || x === "same")) {
          lines.push(`${l.name} and ${r.name} oppose each other, but ${m.name} gets on with both: it can bridge the two.`);
        }
      }
      return lines;
    }

    function render() {
      // The first two slots are required and the third is optional, so a card
      // always shows (and is saved) under the slot it was picked in.
      const all = chosen();
      // Keep the choice in the address so it can be shared or bookmarked.
      const params = new URLSearchParams();
      all.forEach((p, i) => p.card && params.set(String.fromCharCode(97 + i), `${p.card.slug}${p.reversed ? "~r" : ""}`));
      history.replaceState(null, "", params.toString() ? `?${params}` : location.pathname);
      out.replaceChildren();
      if (!all[0]!.card || !all[1]!.card) return;
      const picked = (all[2]?.card ? all : all.slice(0, 2)) as { card: Card; reversed: boolean }[];
      const table = el("div", "table");
      table.dataset.count = String(picked.length);
      picked.forEach((p, i) => table.append(face(p.card, p.reversed, cfg.slots[i] ?? "")));
      const notes = cfg.mode === "combine"
        ? combineNotes(picked[0]!.card, picked[0]!.reversed, picked[1]!.card, picked[1]!.reversed)
        : elementNotes(picked.map((p) => p.card));
      const panel = el("div", "panel summary");
      panel.append(el("h3", "", cfg.mode === "combine" ? "Reading them together" : "Elemental dignities"));
      const ul = el("ul");
      for (const l of notes) ul.append(el("li", "", l));
      panel.append(ul);
      if (cfg.mode === "combine") {
        const qs = picked.map((p) => (p.reversed ? p.card.revQ : p.card.upQ)).filter(Boolean);
        if (qs.length) {
          panel.append(el("p", "quint", "Questions to reflect on:"));
          const ql = el("ul", "questions-mini");
          for (const q of qs) ql.append(el("li", "", q));
          panel.append(ql);
        }
      }
      out.append(table, panel);
    }

    function randomize() {
      const d = cfg.deck.slice();
      selects.forEach((s, i) => {
        const j = rand(d.length);
        s.value = d.splice(j, 1)[0]!.slug;
        if (revs[i]) revs[i]!.checked = rand(4) === 0;
      });
      render();
    }

    selects.forEach((s) => (s.onchange = render));
    revs.forEach((r) => (r.onchange = render));
    root.querySelector<HTMLButtonElement>("[data-random]")!.onclick = randomize;

    const params = new URLSearchParams(location.search);
    selects.forEach((s, i) => {
      const v = params.get(String.fromCharCode(97 + i));
      if (!v) return;
      const [slug, flag] = v.split("~");
      if (bySlug.has(slug!)) s.value = slug!;
      if (revs[i]) revs[i]!.checked = flag === "r";
    });
    render();
  }
</script>
