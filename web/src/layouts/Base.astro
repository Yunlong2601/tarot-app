---
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource-variable/inter";
import "../styles/site.css";
import Logo from "../components/Logo.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { BASE, SUPPORT_EMAIL } from "../config.ts";
import { TOPICS } from "../lib/topics.ts";

interface Props {
  title: string;
  description: string;
  /** This page's address under the site, e.g. "cards" ("" = home). */
  path: string;
  /** Hide the "Read your own cards" panel (pages that already end with one). */
  noCta?: boolean;
  /** Share preview image under the site, e.g. "cards/art/major_00_fool.jpg". */
  image?: string;
  /** "Home › Section › Page" trail for search results: [name, path] pairs after Home. */
  crumbs?: [string, string][];
  /** Extra schema.org data for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Let the page lay out its own full-width sections (the home page). */
  bare?: boolean;
}
const { title, description, path, noCta = false, image = "og.png", crumbs = [], jsonLd = [], bare = false } = Astro.props;
const nav = [
  ["Card meanings", "cards"],
  ["Spreads", "spreads"],
  ["Yes or No", "tools/yes-no"],
  ["Free tools", "tools"],
];
const year = new Date().getFullYear();
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const base = BASE;
const schema = [...jsonLd];
if (crumbs.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [["ShenTarot", ""], ...crumbs].map(([name, p], i) => ({
      "@type": "ListItem",
      position: i + 1,
      name,
      item: new URL(p, Astro.site).href,
    })),
  });
}
// Escapes "<" so page text can never close the script tag.
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ShenTarot" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    {schema.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <meta name="theme-color" content="#09080f" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}`} aria-label="ShenTarot home"><Logo />ShenTarot</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([name, p]) => (
            <a href={`${base}${p}`} aria-current={path === p || (p !== "tools" && path.startsWith(`${p}/`)) || (p === "tools" && path.startsWith("tools/") && path !== "tools/yes-no") ? "page" : undefined}>{name}</a>
          ))}
        </nav>
        <a class="btn btn-gold btn-sm header-cta" href={`${base}#get-app`}>Get the app</a>
      </div>
    </header>
    <main id="main">
      {bare ? <slot /> : <div class="wrap"><slot /></div>}
      {!noCta && (
        <section class="wrap section" id={bare ? undefined : "get-app"}>
          <div class="cta-band">
            <p class="eyebrow">ShenTarot for iPhone and Android</p>
            <h2>Read your own cards</h2>
            <p>Scan your Rider-Waite-Smith deck or draw on screen, ask your question and get a reading you can keep asking about.</p>
            <StoreButtons center />
          </div>
        </section>
      )}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={`${base}`}><Logo />ShenTarot</a>
            <p class="about">AI tarot readings for your own cards, from ShenTech in Singapore. For entertainment and self-reflection only.</p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href={`${base}cards`}>Card meanings</a></li>
              <li><a href={`${base}spreads`}>Tarot spreads</a></li>
              <li><a href={`${base}tools/yes-no`}>Yes or No tarot</a></li>
              <li><a href={`${base}tools/daily-card`}>Card of the day</a></li>
              <li><a href={`${base}tools/combinations`}>Card combinations</a></li>
              <li><a href={`${base}tools/elements`}>Elemental dignities</a></li>
              <li><a href={`${base}tools/random-card`}>Draw a card</a></li>
              <li><a href={`${base}tools/birth-card`}>Birth card calculator</a></li>
              <li><a href={`${base}tools/love-compatibility`}>Love compatibility</a></li>
              <li><a href={`${base}tools`}>All free tools</a></li>
            </ul>
          </div>
          <div>
            <h4>Readings</h4>
            <ul>
              {TOPICS.map((t) => <li><a href={`${base}topics/${t.slug}`}>{t.title}</a></li>)}
              <li><a href={`${base}questions`}>Tarot questions</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href={`mailto:${SUPPORT_EMAIL}`}>Support</a></li>
              <li><a href={`${base}privacy`}>Privacy</a></li>
              <li><a href={`${base}terms`}>Terms</a></li>
              <li><a href={`${base}delete-account`}>Delete your data</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>© {year} ShenTech, Singapore. All rights reserved.</span>
          <span>Card images: Rider-Waite-Smith deck (1909), public domain.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
