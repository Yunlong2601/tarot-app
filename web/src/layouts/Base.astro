---
import "../styles/site.css";
import StoreButtons from "../components/StoreButtons.astro";
import { BASE } from "../config.ts";

interface Props {
  title: string;
  description: string;
  /** This page's address under the site, e.g. "cards" ("" = home). */
  path: string;
  /** Hide the "Read your own cards" panel (pages that already end with one). */
  noCta?: boolean;
  /** Share preview image under the site, e.g. "cards/art/major_00_fool.jpg". */
  image?: string;
  /** "Home › Section › Page" trail for search results: [name, path] pairs after Home. */
  crumbs?: [string, string][];
  /** Extra schema.org data for this page. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path, noCta = false, image = "og.png", crumbs = [], jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const base = BASE;
const schema = [...jsonLd];
if (crumbs.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [["ShenTarot", ""], ...crumbs].map(([name, p], i) => ({
      "@type": "ListItem",
      position: i + 1,
      name,
      item: new URL(p, Astro.site).href,
    })),
  });
}
// Escapes "<" so page text can never close the script tag.
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ShenTarot" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    {schema.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <meta name="theme-color" content="#0d0c0a" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={`${base}`}>ShenTarot</a>
      <nav aria-label="Main">
        <a href={`${base}cards`}>Card meanings</a>
        <a href={`${base}spreads`}>Spreads</a>
        <a href={`${base}tools/random-card`}>Draw a card</a>
        <a href={`${base}tools/birth-card`}>Birth cards</a>
      </nav>
    </header>
    <main id="main">
      <slot />
      {!noCta && (
        <section class="cta">
          <h2>Read your own cards</h2>
          <p>Scan your own Rider-Waite-Smith deck or draw on screen, and get a reading for your question.</p>
          <StoreButtons />
        </section>
      )}
    </main>
    <footer>
      <p>For entertainment and self-reflection only. Card images: Rider-Waite-Smith deck (1909), public domain.</p>
      <p><a href={`${base}privacy`}>Privacy</a> · <a href={`${base}terms`}>Terms</a> · <a href={`${base}delete-account`}>Delete your data</a></p>
    </footer>
  </body>
</html>
