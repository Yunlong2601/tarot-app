---
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/cormorant-garamond/cyrillic-500.css";
import "@fontsource/cormorant-garamond/cyrillic-600.css";
import "@fontsource-variable/inter";
import "../styles/site.css";
import "../styles/ritual.css";
import "../styles/interactions.css";
import TarotSearch from "../components/TarotSearch.astro";
import { ritualCopy } from "../i18n/ritual";
import Logo from "../components/Logo.astro";
import BetaInvite from "../components/BetaInvite.astro";
import { betaCopy } from "../i18n/beta";
import { BASE, SUPPORT_EMAIL } from "../config.ts";
import { TOPICS } from "../lib/topics.ts";
import { LOCALES, LOCALE_INFO, i18n, prefix, type Locale } from "../i18n/index.ts";

interface Props {
  title: string;
  description: string;
  /** This page's address under the site, e.g. "cards" ("" = home). */
  path: string;
  /** Hide the "Read your own cards" panel (pages that already end with one). */
  noCta?: boolean;
  /** Share preview image under the site, e.g. "cards/art/major_00_fool.jpg". */
  image?: string;
  /** "Home › Section › Page" trail for search results: [name, path] pairs after Home. */
  crumbs?: [string, string][];
  /** Extra schema.org data for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Let the page lay out its own full-width sections (the home page). */
  bare?: boolean;
  /** The page's language. */
  lang?: Locale;
  /** False for pages that exist in English only (legal pages, 404). */
  localized?: boolean;
  /** Local research/prototype pages must stay out of search indexes. */
  noIndex?: boolean;
}
const { title, description, path, noCta = false, image = "og.png", crumbs = [], jsonLd = [], bare = false, lang = "en", localized = true, noIndex = false } = Astro.props;
const L = i18n(lang);
const R = ritualCopy(lang);
const I = L.interactions;
const beta = betaCopy(lang);
const toolGroups = [[I.drawReflect, [[R.draw,"tools/random-card",L.t("tools.list.random-card.text")],[L.t("footer.daily"),"tools/daily-card",L.t("tools.list.daily-card.text")],[L.workspace.title,"read",L.workspace.description]]], [I.compareExplore, [[L.t("footer.combinations"),"tools/combinations",L.t("tools.list.combinations.text")],[L.t("footer.elements"),"tools/elements",L.t("tools.list.elements.text")],[L.t("footer.birth"),"tools/birth-card",L.t("tools.list.birth-card.text")]]]] as [string,[string,string,string][]][];
const t = L.t;
const nav = [
  [t("nav.cards"), "cards"],
  [t("nav.spreads"), "spreads"],
  [L.learn.nav, "learn"],
  [L.workspace.astrology, "astrology"],
  [L.workspace.title, "read"],
  [t("nav.tools"), "tools"],
];
const year = new Date().getFullYear();
// The legal pages exist in English only, and say so in other languages.
const legal = (key: string) => (lang === "en" ? t(key) : t("footer.inEnglish", { page: t(key) }));
const here = (loc: Locale) => new URL(`${prefix(loc)}${path}`.replace(/\/$/, ""), Astro.site).href;
const canonical = here(lang);
const imageUrl = new URL(image, Astro.site).href;
const base = BASE;
const u = L.url;
const schema = [...jsonLd];
if (crumbs.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [["ShenTarot", ""], ...crumbs].map(([name, p], i) => ({
      "@type": "ListItem",
      position: i + 1,
      name,
      item: new URL(`${prefix(lang)}${p}`.replace(/\/$/, ""), Astro.site).href,
    })),
  });
}
// Escapes "<" so page text can never close the script tag.
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={L.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {localized && LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_INFO[l].tag} href={here(l)} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={here("en")} />}
    <meta property="og:locale" content={LOCALE_INFO[lang].og} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ShenTarot" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    {schema.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <meta name="theme-color" content="#f4f0e7" />
    <meta name="shentarot-design" content="quiet-ritual-v1" />
  </head>
  <body>
    <a class="skip" href="#main">{t("base.skip")}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={u()} aria-label={t("base.home")}><Logo />ShenTarot</a>
        <nav class="desktop-nav" aria-label={t("base.mainNav")}>
          {nav.slice(0,3).map(([name,p]) => <a href={u(p)} aria-current={path === p || path.startsWith(`${p}/`) ? "page" : undefined}>{name}</a>)}
          <details class="nav-more field-guide"><summary>{t("nav.tools")}</summary><div class="field-guide-panel">
            {toolGroups.map(([heading,links])=><section><h2>{heading}</h2>{links.map(([name,path,description])=><a href={u(path)} data-guide-preview={description}><strong>{name}</strong><small>{description}</small></a>)}</section>)}
            <aside class="guide-preview"><img src={`${base}ritual-card-back.svg`} alt="" width="88" height="151"/><p data-guide-caption>{I.menuLead}</p></aside>
            <div class="guide-bottom"><a href={u("tools")}>{t("footer.allTools")} →</a><a href={u("astrology")}>{L.workspace.astrology}</a></div>
          </div></details>
          <a href={u("beta")} aria-current={path === 'beta' ? 'page' : undefined}>{beta.nav}</a>
        </nav>
        <a class="header-search icon-button" href={u("search")} data-open-search aria-label={I.title}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
        <details class="lang-menu">
          <summary aria-label={`${LOCALE_INFO[lang].name} — ${t("base.language")}`}>{LOCALE_INFO[lang].name}</summary>
          <ul>{LOCALES.map((l) => <li><a href={localized ? here(l).replace(Astro.site!.origin, "") : `${base}${prefix(l)}`.replace(/\/$/, "") || "/"} hreflang={LOCALE_INFO[l].tag} lang={LOCALE_INFO[l].tag} aria-current={l === lang ? "true" : undefined}>{LOCALE_INFO[l].name}</a></li>)}</ul>
        </details>
        <a class="btn btn-gold btn-sm header-cta" href={path === "beta" ? "#choose-phone" : `${u()}#ritual`} aria-label={path === "beta" ? beta.choose : R.draw}><span class="cta-word">{path === "beta" ? beta.choose : R.draw}</span><span class="cta-symbol" aria-hidden="true">✦</span></a>
        <details class="mobile-menu mobile-fallback"><summary>{R.menu}<svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav aria-label={t("base.mainNav")}>
          <a href={path === "beta" ? "#choose-phone" : `${u()}#ritual`}>{path === "beta" ? beta.choose : R.draw}</a>{nav.map(([name,p])=><a href={u(p)}>{name}</a>)}<a href={u("beta")}>{beta.nav}</a>
          <div class="fallback-languages">{LOCALES.map(l=><a href={localized?here(l).replace(Astro.site!.origin,""):`${base}${prefix(l)}`.replace(/\/$/, "") || "/"} lang={LOCALE_INFO[l].tag}>{LOCALE_INFO[l].name}</a>)}</div>
        </nav></details>
        <button type="button" class="mobile-menu-trigger" data-open-mobile hidden aria-haspopup="dialog">{R.menu}<svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </header>
    <TarotSearch L={L}/>
    <dialog id="mobile-navigation" class="ritual-dialog mobile-nav-dialog" aria-labelledby="mobile-nav-title">
      <div class="dialog-heading"><h2 id="mobile-nav-title">{R.menu}</h2><button type="button" class="icon-button" data-dialog-close aria-label={I.close}>×</button></div>
      <nav aria-label={t("base.mainNav")}><a class="btn btn-gold" href={path === "beta" ? "#choose-phone" : `${u()}#ritual`}>{path === "beta" ? beta.choose : R.draw} ↗</a>{nav.map(([name,p])=><a href={u(p)}>{name}<span aria-hidden="true">↗</span></a>)}<a href={u("beta")}>{beta.nav}<span aria-hidden="true">↗</span></a></nav>
      <section class="mobile-languages"><h3>{t("base.language")}</h3>{LOCALES.map(l=><a href={localized?here(l).replace(Astro.site!.origin,""):`${base}${prefix(l)}`.replace(/\/$/, "") || "/"} lang={LOCALE_INFO[l].tag} hreflang={LOCALE_INFO[l].tag} aria-current={l===lang?"true":undefined}>{LOCALE_INFO[l].name}</a>)}</section>
    </dialog>
    <main id="main">
      {bare ? <slot /> : <div class="wrap"><slot /></div>}
      {!noCta && (
        <section class="wrap section" id={bare ? undefined : "get-app"}>
          <div class="cta-band">
            <h2>{beta.appTitle}</h2>
            <p>{beta.appNote}</p>
            <BetaInvite lang={lang}/>
          </div>
        </section>
      )}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={u()}><Logo />ShenTarot</a>
            <p class="about">{L.growth.footer}</p>
          </div>
          <div>
            <h4>{t("footer.explore")}</h4>
            <ul>
              <li><a href={u("cards")}>{t("footer.cards")}</a></li>
              <li><a href={u("spreads")}>{t("footer.spreads")}</a></li>
              <li><a href={u("learn")}>{L.learn.footer}</a></li>
              <li><a href={u("tools/yes-no")}>{t("footer.yesNo")}</a></li>
              <li><a href={u("tools/daily-card")}>{t("footer.daily")}</a></li>
              <li><a href={u("tools/combinations")}>{t("footer.combinations")}</a></li>
              <li><a href={u("tools/elements")}>{t("footer.elements")}</a></li>
              <li><a href={u("tools/random-card")}>{t("footer.random")}</a></li>
              <li><a href={u("tools/birth-card")}>{t("footer.birth")}</a></li>
              <li><a href={u("tools/love-compatibility")}>{t("footer.compat")}</a></li>
              <li><a href={u("tools")}>{t("footer.allTools")}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t("footer.readings")}</h4>
            <ul>
              {TOPICS.map((tp) => <li><a href={u(`topics/${tp.slug}`)}>{L.content.topics[tp.slug as keyof typeof L.content.topics].title}</a></li>)}
              <li><a href={u("questions")}>{t("footer.questions")}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t("footer.company")}</h4>
            <ul>
              <li><a href={u("about")}>{t("footer.about")}</a></li>
              <li><a href={u("methodology")}>{L.growth.methodTitle}</a></li>
              <li><a href={u("learn/beginner-reference")}>{L.growth.guideTitle}</a></li>
              <li><a href={`mailto:${SUPPORT_EMAIL}`}>{t("footer.support")}</a></li>
              <li><a href={`${base}privacy`}>{legal("footer.privacy")}</a></li>
              <li><a href={`${base}terms`}>{legal("footer.terms")}</a></li>
              <li><a href={`${base}delete-account`}>{legal("footer.delete")}</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>{t("footer.copyright", { year })}</span>
          <span>{t("footer.images")}</span>
        </div>
      </div>
    </footer>
    <script src="../scripts/shell.ts"></script>
    <script>
      const disclosures = document.querySelectorAll<HTMLDetailsElement>('.site-header details');
      disclosures.forEach(detail => {
        detail.addEventListener('toggle', () => { if(detail.open) disclosures.forEach(other=>{if(other!==detail) other.open=false;}); });
        detail.addEventListener('keydown', event=>{ if(event.key==='Escape' && detail.open) { detail.open=false; detail.querySelector('summary')?.focus(); } });
        detail.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{detail.open=false;}));
      });
      document.addEventListener('click',event=>{ if(event.target instanceof Node) disclosures.forEach(detail=>{if(!detail.contains(event.target as Node)) detail.open=false;}); });
    </script>
  </body>
</html>
