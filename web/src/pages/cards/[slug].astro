---
import Base from "../../layouts/Base.astro";
import Tabs from "../../components/Tabs.astro";
import { BASE } from "../../config.ts";
import { CARDS, GROUP_ABOUT, cardIds, slug, suitTitle, type CardId } from "../../lib/data.ts";

export function getStaticPaths() {
  return cardIds.map((id) => ({ params: { slug: slug(id) }, props: { id } }));
}
const { id } = Astro.props as { id: CardId };
const c = CARDS[id];
const k = c.k;
const kind = c.arcana === "major" ? `Major Arcana · ${c.number}` : `Minor Arcana · ${suitTitle(c.suit)}`;
const facts = [c.element && `Element: ${c.element}`, c.association && `Traditional association: ${c.association}`]
  .filter(Boolean)
  .join(" · ");
const i = cardIds.indexOf(id);
const prev = cardIds.at(i - 1)!;
const next = cardIds.at((i + 1) % cardIds.length)!;
const group = c.arcana === "major" ? "major" : c.suit!;
const NUMBER_WORDS = ["", "Aces", "Twos", "Threes", "Fours", "Fives", "Sixes", "Sevens", "Eights", "Nines", "Tens"];
const RANKS = ["page", "knight", "queen", "king"];
const rank = RANKS.find((r) => id.endsWith(`_${r}`));
const digitSum = (n: number) => String(n).split("").reduce((a, d) => a + Number(d), 0);

// Cards linked to this one by number or rank, with a line saying how.
let related: CardId[] = [];
let relatedNote = "";
if (c.arcana === "major" && c.number) {
  const n = c.number > 10 ? digitSum(c.number) : c.number;
  related = cardIds.filter((x) => CARDS[x].arcana === "minor" && CARDS[x].number === n);
  relatedNote = c.number > 10
    ? `${c.number} adds up to ${n} (${String(c.number).split("").join(" + ")}), the number of the ${NUMBER_WORDS[n]!.toLowerCase()}.`
    : `The Minor Arcana cards that share the number ${n}.`;
} else if (rank) {
  related = cardIds.filter((x) => x !== id && x.endsWith(`_${rank}`));
  relatedNote = `The other ${rank}s: the same kind of person or approach, in another area of life.`;
} else if (c.number) {
  const major = cardIds.find((x) => CARDS[x].arcana === "major" && CARDS[x].number === c.number);
  related = [...(major ? [major] : []), ...cardIds.filter((x) => x !== id && CARDS[x].arcana === "minor" && CARDS[x].number === c.number)];
  relatedNote = `The other ${NUMBER_WORDS[c.number]!.toLowerCase()}${major ? `, and ${CARDS[major].name}, Major Arcana card ${c.number}` : ""}: the same stage of a story in other parts of life.`;
}

const faq: [string, string][] = k
  ? [
      [`What does ${c.name} mean in tarot?`, `${k.upright.core} Keywords: ${c.keywords.join(", ")}.`],
      [`What does ${c.name} mean reversed?`, `${k.reversed.core} ${k.reversed.modes.join(" ")}`],
      [`What does ${c.name} mean in love?`, k.upright.love],
      [`What does ${c.name} mean for work?`, k.upright.work],
      [`What question does ${c.name} ask?`, `Upright: ${k.upright.question} Reversed: ${k.reversed.question}`],
    ]
  : [];
const jsonLd = faq.length
  ? [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }]
  : [];
---
<Base
  title={`${c.name} tarot card meaning: upright and reversed · ShenTarot`}
  description={`${c.name} meaning in tarot, upright and reversed: ${c.keywords.join(", ")}. ${k?.essence ?? c.upright}`}
  path={`cards/${slug(id)}`}
  image={`cards/art/${id}.jpg`}
  crumbs={[["Card meanings", "cards"], [c.name, `cards/${slug(id)}`]]}
  jsonLd={jsonLd}
>
  <ol class="crumbs" style="margin-top:2rem">
    <li><a href={`${BASE}`}>Home</a></li>
    <li><a href={`${BASE}cards`}>Card meanings</a></li>
    <li><a href={`${BASE}cards#${group}`}>{suitTitle(c.suit)}</a></li>
  </ol>
  <section class="card-hero">
    <div class="card-frame">
      <img src={`${BASE}cards/art/${id}.jpg`} alt={`${c.name}, Rider-Waite-Smith deck`} width="300" height="514" fetchpriority="high" />
    </div>
    <div>
      <p class="meta">{kind}</p>
      <h1>{c.name}</h1>
      {k && <p class="essence">{k.essence}</p>}
      <p class="lead">{c.upright}</p>
      <ul class="chips">{c.keywords.map((w) => <li>{w}</li>)}</ul>
      {facts && <p class="muted">{facts}</p>}
    </div>
  </section>
  <Tabs label={`About ${c.name}`} tabs={[
    { id: "meaning", label: "Meaning" },
    ...(k ? [{ id: "love-work", label: "Love and work" }] : []),
    { id: "related", label: "Related cards" },
    ...(faq.length ? [{ id: "faq", label: "Questions" }] : []),
  ]}>
    <div data-panel="meaning">
  {k ? (
    <>
      <div class="panel" style="margin-bottom:1rem">
        <h2>What the card shows</h2>
        <p>{k.imagery}</p>
        <p class="muted">{k.why}</p>
      </div>
      <div class="meaning">
        <div class="panel">
          <h2><span>▲</span>Upright</h2>
          <p>{k.upright.core}</p>
          <div class="dl">
            <div><b>Light</b>{k.upright.light}</div>
            <div><b>Shadow</b>{k.upright.shadow}</div>
            <div><b>Love</b>{k.upright.love}</div>
            <div><b>Work</b>{k.upright.work}</div>
          </div>
          <p class="reflect">{k.upright.question}</p>
        </div>
        <div class="panel">
          <h2><span>▼</span>Reversed</h2>
          <p>{k.reversed.core}</p>
          <div class="dl">{k.reversed.modes.map((m) => <div>{m}</div>)}</div>
          <p class="reflect">{k.reversed.question}</p>
        </div>
      </div>
    </>
  ) : (
    <div class="meaning">
      <div class="panel"><h2><span>▲</span>Upright</h2><p>{c.upright}</p></div>
      <div class="panel"><h2><span>▼</span>Reversed</h2><p>{c.reversed}</p></div>
    </div>
  )}
    </div>
    {k && <div data-panel="love-work">
  {k && (
    <section class="section" style="padding-bottom:0">
      <h2>{c.name} in a reading</h2>
      <div class="grid-3">
        <div class="panel">
          <h3>In love</h3>
          <p>{k.upright.love}</p>
          <p class="muted">Reversed: {k.reversed.core}</p>
        </div>
        <div class="panel">
          <h3>At work</h3>
          <p>{k.upright.work}</p>
          <p class="muted">Its shadow side: {k.upright.shadow}.</p>
        </div>
        <div class="panel">
          <h3>{c.arcana === "major" ? "As a Major Arcana card" : `As one of the ${suitTitle(c.suit)}`}</h3>
          <p>{GROUP_ABOUT[group]}. {c.arcana === "major" ? "A Major Arcana card points to a bigger theme than the everyday cards around it." : `${c.element ? `The suit's element is ${c.element}. ` : ""}It shows where in daily life the reading plays out.`}</p>
          <p><a class="link-arrow" href={`${BASE}cards#${group}`}>All {suitTitle(c.suit)}</a></p>
        </div>
      </div>
    </section>
  )}
    </div>}
    <div data-panel="related">
  {related.length > 0 && (
    <section class="section" style="padding-bottom:0">
      <h2>Related cards</h2>
      <p class="muted">{relatedNote}</p>
      <div class="card-row">
        {related.map((r) => (
          <a class="tcard" href={`${BASE}cards/${slug(r)}`}>
            <img src={`${BASE}cards/art/${r}.jpg`} alt="" loading="lazy" width="150" height="257" />
            {CARDS[r].name}
          </a>
        ))}
      </div>
    </section>
  )}
  <section class="section" style="padding-bottom:0">
    <h2>Read it with other cards</h2>
    <div class="grid-3">
      <a class="panel tool-tile" href={`${BASE}tools/combinations?a=${slug(id)}`}><div><h3>Card combinations</h3><p>Pick a second card and see how {c.name} reads with it.</p><span class="link-arrow">Combine</span></div></a>
      <a class="panel tool-tile" href={`${BASE}tools/elements?b=${slug(id)}`}><div><h3>Elemental dignities</h3><p>See which neighbours strengthen or weaken {c.name}.</p><span class="link-arrow">Check</span></div></a>
      <a class="panel tool-tile" href={`${BASE}tools/yes-no`}><div><h3>Yes or No tarot</h3><p>Draw three cards for a yes or no question.</p><span class="link-arrow">Ask</span></div></a>
    </div>
  </section>
    </div>
    {faq.length > 0 && <div data-panel="faq">
  {faq.length > 0 && (
    <section class="section" style="padding-bottom:0">
      <h2 class="center">Questions about {c.name}</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
    </div>}
  </Tabs>
  <nav class="pager" aria-label="More cards">
    <a class="panel" href={`${BASE}cards/${slug(prev)}`}>
      <img src={`${BASE}cards/art/${prev}.jpg`} alt="" loading="lazy" width="150" height="257" />
      <span><small>Previous card</small><b>{CARDS[prev].name}</b></span>
    </a>
    <a class="panel next" href={`${BASE}cards/${slug(next)}`}>
      <span><small>Next card</small><b>{CARDS[next].name}</b></span>
      <img src={`${BASE}cards/art/${next}.jpg`} alt="" loading="lazy" width="150" height="257" />
    </a>
  </nav>
</Base>
