---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { CARDS, cardIds, slug, suitTitle, type CardId } from "../../lib/data.ts";

export function getStaticPaths() {
  return cardIds.map((id) => ({ params: { slug: slug(id) }, props: { id } }));
}
const { id } = Astro.props as { id: CardId };
const c = CARDS[id];
const k = c.k;
const kind = c.arcana === "major" ? `Major Arcana · ${c.number}` : `Minor Arcana · ${suitTitle(c.suit)}`;
const facts = [c.element && `Element: ${c.element}`, c.association && `Traditional association: ${c.association}`]
  .filter(Boolean)
  .join(" · ");
const i = cardIds.indexOf(id);
const prev = cardIds.at(i - 1)!;
const next = cardIds.at((i + 1) % cardIds.length)!;
---
<Base
  title={`${c.name} tarot card meaning: upright and reversed · ShenTarot`}
  description={`${c.name} meaning in tarot, upright and reversed: ${c.keywords.join(", ")}. ${k?.essence ?? c.upright}`}
  path={`cards/${slug(id)}`}
>
  <p class="muted"><a href={`${BASE}cards`}>Card meanings</a> › {suitTitle(c.suit)}</p>
  <div class="card-top">
    <img class="card-img" src={`${BASE}cards/art/${id}.jpg`} alt={`${c.name}, Rider-Waite-Smith deck`} width="300" height="514" />
    <div>
      <h1>{c.name}</h1>
      <p class="muted">{kind}{facts && ` · ${facts}`}</p>
      <p class="chips">{c.keywords.map((w) => <span>{w}</span>)}</p>
      {k && <p><strong>{k.essence}</strong></p>}
      <p>{c.upright}</p>
    </div>
  </div>
  {k ? (
    <>
      <div class="panel"><h2>What the card shows</h2><p>{k.imagery}</p><p class="muted">{k.why}</p></div>
      <div class="panel">
        <h2>Upright</h2>
        <p>{k.upright.core}</p>
        <p><strong>Light:</strong> {k.upright.light}. <strong>Shadow:</strong> {k.upright.shadow}.</p>
        <p><strong>Love:</strong> {k.upright.love}</p>
        <p><strong>Work:</strong> {k.upright.work}</p>
        <p><em>To reflect on: {k.upright.question}</em></p>
      </div>
      <div class="panel">
        <h2>Reversed</h2>
        <p>{k.reversed.core}</p>
        <ul>{k.reversed.modes.map((m) => <li>{m}</li>)}</ul>
        <p><em>To reflect on: {k.reversed.question}</em></p>
      </div>
    </>
  ) : (
    <>
      <div class="panel"><h2>Upright</h2><p>{c.upright}</p></div>
      <div class="panel"><h2>Reversed</h2><p>{c.reversed}</p></div>
    </>
  )}
  <p>
    <a href={`${BASE}cards/${slug(prev)}`}>‹ {CARDS[prev].name}</a> ·
    <a href={`${BASE}cards/${slug(next)}`}>{CARDS[next].name} ›</a>
  </p>
</Base>
