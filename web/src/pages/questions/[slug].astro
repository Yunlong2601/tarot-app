---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { APP_SPREADS, CARDS, SPREADS, plural, slug } from "../../lib/data.ts";
import { QUESTION_GUIDES, type QuestionGuide } from "../../lib/questions.ts";
import { recommendSpread } from "../../lib/recommend.ts";
import { TOPICS } from "../../lib/topics.ts";

export function getStaticPaths() {
  return QUESTION_GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: QuestionGuide };
const spread = recommendSpread(g.question);
const s = SPREADS[spread];
const topic = TOPICS.find((t) => t.slug === g.topic)!;
const more = QUESTION_GUIDES.filter((x) => x.slug !== g.slug && x.topic === g.topic)
  .concat(QUESTION_GUIDES.filter((x) => x.topic !== g.topic))
  .slice(0, 3);
const href = `${BASE}spreads/${slug(spread)}#try`;
const faq: [string, string][] = [
  [`Can tarot answer "${g.question}"`, g.answer],
  [`Which spread is best for "${g.question}"`, `The ${s.name} spread (${plural(s.positions.length, "card")}). ${APP_SPREADS[spread].blurb}`],
  ["How should I word this question?", `Try asking: ${g.better.join(" ")}`],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---
<Base
  title={`${g.question} Tarot questions and the spread to use · ShenTarot`}
  description={`${g.answer.split(". ")[0]}. Better ways to ask, cards to look out for and the spread that suits it.`}
  path={`questions/${g.slug}`}
  image={`cards/art/${g.cards[0]![0]}.jpg`}
  crumbs={[["Questions", "questions"], [g.question, `questions/${g.slug}`]]}
  jsonLd={[jsonLd]}
>
  <header class="page-head">
    <p class="eyebrow">{topic.name} question</p>
    <h1>{g.question}</h1>
    <p class="lead">{g.answer}</p>
    <p><a class="btn btn-gold" href={href} data-ask-guide={g.question}>Ask this in a reading</a></p>
  </header>

  <section class="section" style="padding-top:0;padding-bottom:0">
    <h2>Better ways to ask</h2>
    <p class="muted">Open questions about you tend to give clearer readings than questions about what someone else will do.</p>
    <ul class="questions">{g.better.map((q) => <li>{q}</li>)}</ul>
  </section>

  <section class="section" style="padding-bottom:0">
    <h2>The spread to use</h2>
    <a class="panel spread-card" href={`${BASE}spreads/${slug(spread)}`} style="max-width:26rem">
      <div class="layout" aria-hidden="true">{s.positions.map(() => <i />)}</div>
      <p class="count">{plural(s.positions.length, "card")}</p>
      <h3>{s.name}</h3>
      <p>{APP_SPREADS[spread].blurb}</p>
      <span class="link-arrow">See the positions</span>
    </a>
  </section>

  <section class="section" style="padding-bottom:0">
    <h2>Cards to look out for</h2>
    <div class="card-notes">
      {g.cards.map(([id, note]) => (
        <a class="panel" href={`${BASE}cards/${slug(id)}`}>
          <img src={`${BASE}cards/art/${id}.jpg`} alt="" loading="lazy" width="150" height="257" />
          <span><b>{CARDS[id].name}</b>{note}</span>
        </a>
      ))}
    </div>
    <p class="muted">No single card decides a reading. Read each one in its position and alongside the others.</p>
  </section>

  <section class="section" style="padding-bottom:0">
    <h2>A note before you draw</h2>
    <p>{g.tip}</p>
  </section>

  <section class="section" style="padding-bottom:0">
    <h2 class="center">Questions about this reading</h2>
    <div class="faq">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>More questions</h2>
    <ul class="guide-list">
      {more.map((x) => <li><a href={`${BASE}questions/${x.slug}`}>{x.question}</a></li>)}
    </ul>
    <p><a class="link-arrow" href={`${BASE}topics/${topic.slug}`}>{topic.title}</a></p>
  </section>
</Base>

<script>
  import { ASK_KEY } from "../../lib/recommend.ts";
  // Carry the question to the spread's reader in session storage, never in the address.
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-ask-guide]")) {
    a.addEventListener("click", () => {
      try {
        sessionStorage.setItem(ASK_KEY, a.dataset.askGuide!);
      } catch {}
    });
  }
</script>
