---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { QUESTION_GUIDES } from "../../lib/questions.ts";
import { TOPICS } from "../../lib/topics.ts";

const groups = TOPICS.map((t) => ({ t, guides: QUESTION_GUIDES.filter((g) => g.topic === t.slug) })).filter((x) => x.guides.length);
---
<Base
  title="Tarot questions: what to ask and which spread to use · ShenTarot"
  description="Common tarot questions about love, work and big choices, with better ways to ask them and the spread that suits each one."
  path="questions"
  crumbs={[["Questions", "questions"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Guides</p>
    <h1>Tarot questions</h1>
    <p class="lead">The questions people bring to tarot most often, what the cards can and cannot tell you, and the spread to use.</p>
  </header>
  {groups.map(({ t, guides }) => (
    <section>
      <h2 class="group-title">{t.name}</h2>
      <div class="grid-3">
        {guides.map((g) => (
          <a class="panel spread-card" href={`${BASE}questions/${g.slug}`}>
            <h3>{g.question}</h3>
            <p>{g.answer.split(". ")[0]}.</p>
            <span class="link-arrow">Read the guide</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
