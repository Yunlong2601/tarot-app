---
import Base from '../../../layouts/Base.astro';
import Reader from '../../../components/Reader.astro';
import SearchGrowthNotes from '../../../components/SearchGrowthNotes.astro';
import { drawCopy } from '../../../i18n/draw';
import { i18n, langPaths, type Locale } from '../../../i18n/index.ts';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const L = i18n(lang), { t } = L;
const positions = Array.from({ length: 3 }, (_, i) => drawCopy(lang).position.replace('{n}', String(i + 1)));
---
<Base title={t('random.title')} description={t('random.description')} path="tools/random-card" crumbs={[[t('toolsCrumb'),'tools'],[t('random.crumb'),'tools/random-card']]} lang={lang}>
  <header class="page-head center"><p class="eyebrow">{t('freeTool')}</p><h1>{t('random.h1')}</h1><p class="lead">{t('random.lead')}</p></header>
  <Reader positions={positions} countSelectable lang={lang}/>
  {lang === 'en' && <SearchGrowthNotes kind="draw" />}
</Base>
