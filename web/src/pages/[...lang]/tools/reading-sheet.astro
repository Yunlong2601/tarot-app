---
import Base from "../../layouts/Base.astro";
import { SPREADS, spreadIds } from "../../lib/data.ts";

const sheets = spreadIds.map((id) => ({ id, name: SPREADS[id].name, positions: SPREADS[id].positions }));
---
<Base
  title="Printable tarot reading sheet for any spread · ShenTarot"
  description="Print a free tarot reading sheet for any of our 15 spreads, with every position labelled and space to write your cards and notes."
  path="tools/reading-sheet"
  crumbs={[["Free tools", "tools"], ["Printable reading sheet", "tools/reading-sheet"]]}
>
  <header class="page-head center no-print">
    <p class="eyebrow">Free tool</p>
    <h1>Printable reading sheet</h1>
    <p class="lead">Pick a spread and print a sheet for your journal, with each position labelled and room for your cards and notes.</p>
  </header>
  <div class="panel tool-panel no-print">
    <label>Spread
      <select data-sheet-pick>
        {sheets.map((s) => <option value={s.id} selected={s.id === "three"}>{s.name} ({s.positions.length})</option>)}
      </select>
    </label>
    <button class="btn btn-gold" type="button" data-print>Print</button>
  </div>
  {sheets.map((s) => (
    <section class="sheet" data-sheet={s.id} hidden={s.id !== "three"}>
      <h2>{s.name}</h2>
      <p class="sheet-line">Date: <span></span> Question: <span></span></p>
      <ol>
        {s.positions.map((p) => (
          <li><b>{p}</b><span class="sheet-line">Card: <span></span></span><span class="sheet-lines"></span></li>
        ))}
      </ol>
      <p><b>What I take from this reading</b></p>
      <span class="sheet-lines"></span>
      <p class="sheet-foot">shentarot.com</p>
    </section>
  ))}
</Base>

<script>
  const pickEl = document.querySelector<HTMLSelectElement>("[data-sheet-pick]")!;
  const show = () => document.querySelectorAll<HTMLElement>("[data-sheet]").forEach((s) => (s.hidden = s.dataset.sheet !== pickEl.value));
  pickEl.onchange = show;
  document.querySelector<HTMLButtonElement>("[data-print]")!.onclick = () => print();
</script>
