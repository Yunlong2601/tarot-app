---
import Base from "../../../layouts/Base.astro";
import Linked from "../../../components/Linked.astro";
import Reader from "../../../components/Reader.astro";
import { SITE_URL } from "../../../config";
import { drawCopy } from "../../../i18n/draw";
import { SHENETIC, SHENTAROT_WEBSITE } from "../../../lib/site-entities";
import { i18n, langPaths, type Locale } from "../../../i18n/index.ts";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const L = i18n(lang);
const { t, url } = L;
const draw = drawCopy(lang);
const path = "tools/daily-card";
const page = new URL(url(path), SITE_URL).href;
const jsonLd = [{
  "@context": "https://schema.org", "@type": "WebApplication", "@id": page,
  name: t("daily.h1"), url: page, description: t("daily.description"),
  inLanguage: L.tag, isAccessibleForFree: true, publisher: SHENETIC, isPartOf: SHENTAROT_WEBSITE,
}];
---
<Base
  title={t("daily.title")}
  description={t("daily.description")}
  path={path}
  crumbs={[[t("toolsCrumb"), "tools"], [t("daily.crumb"), path]]}
  lang={lang}
  jsonLd={jsonLd}
>
  <header class="page-head center">
    <p class="eyebrow">{t("freeTool")}</p>
    <h1>{t("daily.h1")}</h1>
    <p class="lead">{t("daily.lead")}</p>
  </header>
  <Reader positions={[t("daily.position")]} mode="daily" button={t("daily.button")} lang={lang} />
  <section class="legal guide" id="daily-guide" data-growth-notes="daily" aria-labelledby="daily-guide-title">
    <h2 id="daily-guide-title">{t("daily.guideTitle")}</h2>
    <ol>
      <li>{t("daily.guideChoose")}</li>
      <li>{t("daily.guideShuffle", { shuffle: draw.shuffle, choose: draw.pickForMe })}</li>
      <li>{t("daily.guideReveal")}</li>
    </ol>
    <h3>{t("daily.rulesTitle")}</h3>
    <p>{t("daily.rules")}</p>
    <p>{t("daily.savedLimits")}</p>
    <h3>{t("daily.exampleTitle")}</h3>
    <Linked text={t("daily.example")} lang={lang} />
    <p><a href={url("topics/daily")}>{L.content.topics.daily.title}</a> · <a href={url("tools/random-card")}>{t("random.crumb")}</a></p>
    <footer class="muted"><p>{L.workspace.disclaimer} <a href={url("methodology")}>{L.growth.methodTitle}</a></p></footer>
  </section>
</Base>
