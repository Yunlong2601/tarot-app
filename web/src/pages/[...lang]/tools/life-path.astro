---
import Base from "../../../layouts/Base.astro";
import { meaningDeck } from "../../../lib/data.ts";
import { i18n, langPaths, type Locale } from "../../../i18n/index.ts";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const L = i18n(lang);
const { t, url: u } = L;

const text = L.content.lifePath as Record<string, string>;
const config = JSON.stringify({ view: L.view, deck: meaningDeck(L).filter((c) => c.suit === null), text, share: L.ui.share, t: { pick: t("pickDate"), yours: t("life.yours"), cardFor: t("life.cardFor") } });
const [before, after] = t("life.note").split("{link}");
---
<Base
  title={t("life.title")}
  description={t("life.description")}
  path="tools/life-path"
  crumbs={[[t("toolsCrumb"), "tools"], [t("life.crumb"), "tools/life-path"]]}
  lang={lang}
>
  <header class="page-head center">
    <p class="eyebrow">{t("freeTool")}</p>
    <h1>{t("life.h1")}</h1>
    <p class="lead">{t("life.lead")}</p>
  </header>
  <div data-life>
    <script type="application/json" data-config set:html={config.replace(/</g, "\\u003c")} />
    <div class="panel tool-panel">
      <label>{t("birthday")} <input type="date" data-bd /></label>
      <button class="btn btn-gold" type="button" data-go>{t("life.button")}</button>
    </div>
    <div class="results" data-out aria-live="polite"></div>
  </div>
  <section class="section" style="padding-bottom:0">
    <h2>{t("life.listTitle")}</h2>
    <ul class="guide-list">
      {Object.entries(text).map(([n, x]) => <li><b>{n}</b>: {x}</li>)}
    </ul>
    <p class="muted">{before}<a href={u("tools/birth-card")}>{t("life.noteLink")}</a>{after}</p>
  </section>
</Base>

<script>
  import { lifePath, lifePathCard, parseDate } from "../../../lib/numerology.ts";
  import { cardResult, el, readConfig, type View } from "../../../lib/cardView.ts";
  import { fill } from "../../../i18n/fill.ts";
  import { shareButtons, type ShareText } from "../../../lib/share.ts";
  import type { MeaningCard } from "../../../lib/data.ts";

  for (const root of document.querySelectorAll<HTMLElement>("[data-life]")) {
    const cfg = readConfig<{ view: View; deck: MeaningCard[]; text: Record<string, string>; share: ShareText & Record<string, string>; t: Record<string, string> }>(root);
    const out = root.querySelector<HTMLElement>("[data-out]")!;
    root.querySelector<HTMLInputElement>("[data-bd]")!.max = new Date().toISOString().slice(0, 10);
    root.querySelector<HTMLButtonElement>("[data-go]")!.onclick = () => {
      const d = parseDate(root.querySelector<HTMLInputElement>("[data-bd]")!.value);
      if (!d) {
        out.replaceChildren(el("p", "center muted", cfg.t.pick));
        return;
      }
      const n = lifePath(...d);
      const c = cfg.deck.find((x) => x.n === lifePathCard(n))!;
      const head = el("div", "center");
      head.append(el("p", "eyebrow", cfg.t.yours), el("p", "big-number", String(n)), el("p", "", cfg.text[n]!));
      const img = shareButtons(() => ({ base: cfg.view.base, eyebrow: fill(cfg.share.life!, { n }), title: c.name, text: cfg.text[n]!, cards: [{ id: c.id, name: c.name }], file: `shentarot-life-path-${n}` }), cfg.share);
      out.replaceChildren(head, cardResult(c, cfg.view, fill(cfg.t.cardFor!, { n }), c.core), img);
    };
  }
</script>
