---
import Base from "../../../layouts/Base.astro";
import Pairing from "../../../components/Pairing.astro";
import { i18n, langPaths, type Locale } from "../../../i18n/index.ts";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const L = i18n(lang);
const { t, url: u } = L;

const [a, rest] = t("comb.note").split("{elements}");
const [b, c] = (rest ?? "").split("{cards}");
---
<Base
  title={t("comb.title")}
  description={t("comb.description")}
  path="tools/combinations"
  crumbs={[[t("toolsCrumb"), "tools"], [t("comb.crumb"), "tools/combinations"]]}
  lang={lang}
>
  <header class="page-head center">
    <p class="eyebrow">{t("freeTool")}</p>
    <h1>{t("comb.h1")}</h1>
    <p class="lead">{t("comb.lead")}</p>
  </header>
  <Pairing mode="combine" slots={L.list("comb.slots")} lang={lang} />
  <section class="narrow" style="margin:3rem auto 0">
    <h2>{t("comb.howTitle")}</h2>
    <ul>{L.list("comb.how").map((x) => <li>{x}</li>)}</ul>
    <p class="muted">{a}<a href={u("tools/elements")}>{t("comb.elementsLink")}</a>{b}<a href={u("cards")}>{t("comb.cardsLink")}</a>{c}</p>
  </section>
</Base>
