---
import ReferenceSource from "../../../../components/ReferenceSource.astro";
import Linked from "../../../../components/Linked.astro";
import Base from "../../../../layouts/Base.astro";
import SearchGrowthNotes from "../../../../components/SearchGrowthNotes.astro";
import { BASE } from "../../../../config.ts";
import { cardIds, slug, type CardId } from "../../../../lib/data.ts";
import { CONTEXTS, CONTEXT_KEY, type Context } from "../../../../lib/contexts.ts";
import { CONTEXT_EVIDENCE } from "../../../../lib/editorial.ts";
import { SHENETIC } from "../../../../lib/site-entities.ts";
import { fill, firstSentence, i18n, langPathsFor, type Locale } from "../../../../i18n/index.ts";

export function getStaticPaths() {
  return langPathsFor(cardIds.flatMap((id) => CONTEXTS.map((ctx) => ({ params: { slug: slug(id), ctx }, props: { id, ctx } }))));
}
const { id, ctx, lang } = Astro.props as { id: CardId; ctx: Context; lang: Locale };
const L = i18n(lang);
const { t, url: u } = L;
const ui = L.contexts.ui;
const tr = L.cards[id]!;
const name = tr.name;
const text = L.contexts.cards[id as keyof typeof L.contexts.cards];
const key = CONTEXT_KEY[ctx];
const body = text[key];
const page = ui.pages[key];
const path = `cards/${slug(id)}/${ctx}`;
const evidenceKey = path as keyof typeof CONTEXT_EVIDENCE;
const evidence = CONTEXT_EVIDENCE[evidenceKey];
const evidenceCopy = evidence && L.contexts.editorial[evidenceKey];
// Yes/no texts open with a bare "Yes." or "No."; the verdict line shows that, so lead with the reason.
const first = evidenceCopy?.answer ?? firstSentence(ctx === "yes-or-no" ? body.up.slice(firstSentence(body.up).length).trim() || body.up : body.up);
const v = (n: number) => (n > 0 ? ui.yes : n < 0 ? ui.no : ui.maybe);
const verdict = ctx === "yes-or-no" ? text.yesno.verdict : null;
const k = tr.k;
const question = evidenceCopy?.questions ?? (k ? [k.upright.question, k.reversed.question] : null);
const advice = evidenceCopy?.advice ?? text.advice;
const h1 = evidenceCopy?.headline ?? fill(page.h1, { name });
const faq: [string, string][] = [
  [evidenceCopy?.faqQuestions[0] ?? fill(page.faqUp, { name }), body.up],
  [evidenceCopy?.faqQuestions[1] ?? fill(page.faqRev, { name }), body.rev],
  [evidenceCopy?.faqQuestions[2] ?? fill(ui.faqAdvice, { name }), advice.up],
];
const pageUrl = new URL(u(path), Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: L.tag,
    mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
  ...(evidence && evidenceCopy ? [{
    "@context": "https://schema.org", "@type": "Article",
    headline: h1, description: first, url: pageUrl, mainEntityOfPage: pageUrl,
    about: { "@id": new URL(u(`cards/${slug(id)}`), Astro.site).href },
    inLanguage: L.tag, dateModified: evidence.checkedAt,
    image: new URL(`cards/art/${id}.jpg`, Astro.site).href,
    author: SHENETIC, publisher: SHENETIC,
    citation: evidence.sources.map(source => ({
      "@type": "Book", name: source.title, url: source.url,
      author: { "@type": "Person", name: source.author },
    })),
  }] : []),
];
const tryHref = u(evidence?.continuePath ?? (ctx === "yes-or-no" ? "tools/yes-no" : ctx === "career" ? "topics/career" : "topics/love"));
---
<Base
  title={evidenceCopy ? `${h1} · ShenTarot` : fill(page.title, { name })}
  description={fill(page.description, { name, first })}
  path={path}
  image={`og/cards/${id}.jpg`}
  crumbs={[[t("cards.crumb"), "cards"], [name, `cards/${slug(id)}`], [h1, path]]}
  jsonLd={jsonLd}
  lang={lang}
>
  <ol class="crumbs" style="margin-top:2rem">
    <li><a href={u()}>{t("card.home")}</a></li>
    <li><a href={u("cards")}>{t("cards.crumb")}</a></li>
    <li><a href={u(`cards/${slug(id)}`)}>{name}</a></li>
  </ol>
  <section class="card-hero">
    <div class="card-frame">
      <img src={`${BASE}cards/art/${id}.jpg`} alt={t("card.imgAlt", { name })} width="300" height="514" fetchpriority="high" />
    </div>
    <div>
      <p class="meta">{ui.eyebrow}</p>
      <h1>{h1}</h1>
      {verdict && <p class="verdict">{ui.upright}: <b class={verdict[0]! > 0 ? "yes" : verdict[0]! < 0 ? "no" : "even"}>{v(verdict[0]!)}</b> · {ui.reversed}: <b class={verdict[1]! > 0 ? "yes" : verdict[1]! < 0 ? "no" : "even"}>{v(verdict[1]!)}</b></p>}
      <p class="answer">{first}</p>
      <ul class="chips">{tr.keywords.map((w) => <li>{w}</li>)}</ul>
      <nav class="ctx-links" aria-label={fill(ui.other, { name })}>
        <a href={u(`cards/${slug(id)}`)}>{ui.tabs.meaning}</a>
        {CONTEXTS.map((c) => <a href={u(`cards/${slug(id)}/${c}`)} aria-current={c === ctx ? "page" : undefined}>{ui.tabs[CONTEXT_KEY[c]]}</a>)}
      </nav>
    </div>
  </section>
  <ReferenceSource lang={lang} path={path} name={h1} />
  {lang === 'en' && id === 'pentacles_ace' && ctx === 'love' && <SearchGrowthNotes kind="love" />}
  <section class="section" style="padding-bottom:0">
    <div class="meaning">
      <div class="panel"><h2><span>▲</span>{ui.upright}</h2><p>{body.up}</p><a href={`${u("read")}?card=${id}`}>{L.workspace.title}</a></div>
      <div class="panel"><h2><span>▼</span>{ui.reversed}</h2><p>{body.rev}</p><a href={`${u("read")}?card=${id}&orientation=reversed`}>{L.workspace.title}</a></div>
    </div>
  </section>
  {evidence && evidenceCopy && <section class="section legal guide" data-context-evidence>
    {evidenceCopy.sections.map(({ h, p, anchor }) => <section>
      <h2 id={anchor}>{h}</h2>
      {p.map(value => <Linked text={value} lang={lang} />)}
    </section>)}
  </section>}
  <section class="section" style="padding-bottom:0">
    <div class="grid-2">
      <div class="panel">
        <h2>{ui.advice}</h2>
        <p>{advice.up}</p>
        <p class="muted">{fill(ui.adviceRev, { text: advice.rev })}</p>
      </div>
      {question && (
        <div class="panel">
          <h2>{ui.reflect}</h2>
          <p>{question[0]}</p>
          <p class="muted">{fill(ui.reflectRev, { text: question[1]! })}</p>
        </div>
      )}
    </div>
  </section>
  <section class="section" style="padding-bottom:0">
    <h2 class="center">{fill(ui.faqTitle, { name })}</h2>
    <div class="faq">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="section center">
    <p class="lead">{evidenceCopy?.continueText ?? ui.tryText}</p>
    <p><a class="btn btn-gold" href={tryHref}>{evidenceCopy?.continueLabel ?? ui.tryCta}</a></p>
  </section>
</Base>
