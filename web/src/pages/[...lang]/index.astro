---
import Base from "../../layouts/Base.astro";
import Tabs from "../../components/Tabs.astro";
import StoreButtons from "../../components/StoreButtons.astro";

import { BASE, SUPPORT_EMAIL } from "../../config.ts";
import { CARDS, cardIds, slug } from "../../lib/data.ts";
import { TOPICS, TOPIC_ART } from "../../lib/topics.ts";
import { i18n, langPaths, type Locale } from "../../i18n/index.ts";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const L = i18n(lang);
const { t, url: u } = L;

const w = L.workspace;
const fan = ["major_17_star", "major_00_fool", "major_02_high_priestess"];
const majors = cardIds.filter((id) => CARDS[id].arcana === "major");
const faq = ["free", "account", "deck", "photo", "how", "predict"].map((k) => [t(`home.faq.${k}.q`), t(`home.faq.${k}.a`)]);
const tiles = [
  { href: "tools/yes-no", key: "yesNo", art: ["major_19_sun", "major_11_justice", "major_18_moon"] },
  { href: "tools/daily-card", key: "daily", art: ["major_17_star", "cups_ace", "major_14_temperance"] },
  { href: "tools/random-card", key: "random", art: ["major_10_wheel_of_fortune", "cups_ace", "major_18_moon"] },
  { href: "tools/birth-card", key: "birth", art: ["major_03_empress", "major_21_world", "major_04_emperor"] },
];
const site = new URL(u(), Astro.site).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: "ShenTech", url: Astro.site!.href, logo: new URL("icon.png", Astro.site).href, email: SUPPORT_EMAIL },
  { "@context": "https://schema.org", "@type": "WebSite", name: "ShenTarot", url: site, inLanguage: L.tag },
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "ShenTarot",
    operatingSystem: "iOS, Android",
    applicationCategory: "LifestyleApplication",
    description: t("home.appDescription"),
    publisher: { "@type": "Organization", name: "ShenTech" },
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title={`${w.homeTitle} · ShenTarot`} description={w.homeLead} path="" jsonLd={jsonLd} bare noCta lang={lang}>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">ShenTarot</p>
        <h1>{w.homeTitle}</h1>
        <p class="lead">{w.homeLead}</p>
        <form class="home-search" action={u("cards")} role="search"><label for="home-card-query">{w.search}</label><div class="action-row"><input id="home-card-query" name="q" type="search" placeholder={w.searchHint} /><button class="btn btn-gold" type="submit">{w.find}</button></div></form>
        <div class="action-row hero-actions"><a class="btn btn-ghost" href={u("spreads")}>{w.choose}</a><a class="btn btn-gold" href={u("read")}>{w.title}</a></div>
        <p class="alt"><a class="link-arrow" href={u("tools/random-card")}>{t("home.drawFree")}</a></p>
      </div>
      <div class="hero-art">
        <div class="fan" aria-hidden="true">
          {fan.map((id, i) => (
            <img src={`${BASE}cards/art/${id}.jpg`} alt="" width="300" height="514" fetchpriority={i === 1 ? "high" : undefined} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="ornament">✦</p>
        <h2>{w.learnPath}</h2>
        <p>{w.practiceHint}</p>
      </div>
      <ol class="steps">
        {[[w.find, "cards"], [w.choose, "spreads"], [w.title, "read"]].map(([name, href]) => <li><h3><a href={u(href)}>{name}</a></h3></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="ornament">✦</p>
        <h2>{t("home.topicsTitle")}</h2>
        <p>{t("home.topicsLead")}</p>
      </div>
      <div class="topic-tiles">
        {TOPICS.map((tp) => {
          const c = L.content.topics[tp.slug as keyof typeof L.content.topics];
          return (
            <a class="topic-tile" href={u(`topics/${tp.slug}`)}>
              <img src={`${BASE}cards/art/${TOPIC_ART[tp.slug]}.jpg`} alt="" loading="lazy" width="300" height="514" />
              <b>{c.name}</b>
              <span>{c.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="ornament">✦</p>
        <h2>{t("home.exploreTitle")}</h2>
      </div>
      <Tabs label={t("home.exploreTitle")} tabs={[
        { id: "tools", label: t("home.tabTools") },
        { id: "major-arcana", label: t("home.tabMajors") },
        { id: "questions", label: t("home.tabQuestions") },
      ]}>
        <div data-panel="tools">
          <div class="section-head">
            <h2 class="sr-only">{t("home.toolsTitle")}</h2>
            <p>{t("home.toolsLead")} <a href={u("tools")}>{t("home.seeAllTools")}</a></p>
          </div>
          <div class="grid-2">
            {tiles.map((tl) => (
              <a class="panel tool-tile" href={u(tl.href)}>
                <div class="mini" aria-hidden="true">
                  {tl.art.map((id) => <img src={`${BASE}cards/art/${id}.jpg`} alt="" loading="lazy" width="150" height="257" />)}
                </div>
                <div><h3>{t(`home.tile.${tl.key}.title`)}</h3><p>{t(`home.tile.${tl.key}.text`)}</p><span class="link-arrow">{t(`home.tile.${tl.key}.cta`)}</span></div>
              </a>
            ))}
          </div>
        </div>
        <div data-panel="major-arcana">
          <div class="section-head">
            <h2 class="sr-only">{t("home.tabMajors")}</h2>
            <p>{t("home.majorsLead")}</p>
          </div>
          <div class="card-row">
            {majors.map((id) => (
              <a class="tcard" href={u(`cards/${slug(id)}`)}>
                <img src={`${BASE}cards/art/${id}.jpg`} alt="" loading="lazy" width="150" height="257" />
                {L.cards[id]!.name}
              </a>
            ))}
          </div>
          <p class="center"><a class="btn btn-ghost" href={u("cards")}>{t("home.allCards")}</a></p>
        </div>
        <div data-panel="questions">
          <div class="section-head">
            <h2 class="sr-only">{t("home.tabQuestions")}</h2>
          </div>
          <div class="faq">
            {faq.map(([q, a]) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </Tabs>
    </div>
  </section>

  <section class="wrap section" id="get-app">
    <div class="cta-band">
      <div class="fan sm" aria-hidden="true">
        {["major_19_sun", "major_21_world", "major_18_moon"].map((id) => (
          <img src={`${BASE}cards/art/${id}.jpg`} alt="" loading="lazy" width="150" height="257" />
        ))}
      </div>
      <h2>{t("home.getTitle")}</h2>
      <p>{t("home.getText")}</p>
      <StoreButtons center lang={lang} />
      <p class="muted" style="margin:1.6rem 0 0;font-size:.85rem">
        {t("home.contact")} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
      </p>
    </div>
  </section>
</Base>
