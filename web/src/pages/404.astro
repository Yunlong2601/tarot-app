---
import Base from "../layouts/Base.astro";
import { BASE } from "../config.ts";
---
<Base title="Page not found · ShenTarot" description="This page does not exist." path="404" noCta>
  <section class="page-head center" style="padding-bottom:4rem">
    <img src={`${BASE}cards/art/major_00_fool.jpg`} alt="" width="150" height="257" style="width:9rem;border-radius:10px;border:1px solid var(--line-strong);margin-bottom:1.5rem" />
    <p class="eyebrow">404</p>
    <h1>This page wandered off</h1>
    <p class="lead">Like the Fool, it stepped off the edge. Try one of these instead.</p>
    <p><a class="btn btn-gold" href={`${BASE}`}>Home</a> <a class="btn btn-ghost" href={`${BASE}cards`}>Card meanings</a></p>
  </section>
</Base>
