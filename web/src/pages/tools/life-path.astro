---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { meaningDeck } from "../../lib/data.ts";
import { LIFE_PATH } from "../../lib/numerology.ts";

const config = JSON.stringify({ base: BASE, deck: meaningDeck.filter((c) => c.suit === null), text: LIFE_PATH });
---
<Base
  title="Life path number calculator with its tarot card · ShenTarot"
  description="Work out your numerology life path number from your birthday, including master numbers 11, 22 and 33, and see the Major Arcana card that goes with it."
  path="tools/life-path"
  crumbs={[["Free tools", "tools"], ["Life path number", "tools/life-path"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Free tool</p>
    <h1>Life path number and tarot card</h1>
    <p class="lead">
      Add up every digit of your birth date and reduce it to one digit, keeping the master numbers 11, 22 and 33.
      Each number has a Major Arcana card. Worked out in your browser; nothing is sent.
    </p>
  </header>
  <div data-life>
    <script type="application/json" data-config set:html={config.replace(/</g, "\\u003c")} />
    <div class="panel tool-panel">
      <label>Your birthday <input type="date" data-bd /></label>
      <button class="btn btn-gold" type="button" data-go>Find my number</button>
    </div>
    <div class="results" data-out aria-live="polite"></div>
  </div>
  <section class="section" style="padding-bottom:0">
    <h2>The numbers and their cards</h2>
    <ul class="guide-list">
      {Object.entries(LIFE_PATH).map(([n, t]) => <li><b>{n}</b>: {t}</li>)}
    </ul>
    <p class="muted">Numbers 1 to 9 and 11 match the Major Arcana card with that number. 22 is The Fool, and 33 adds to 6, The Lovers. This is a different sum from the <a href={`${BASE}tools/birth-card`}>birth card</a>, which adds the month, day and year as whole numbers.</p>
  </section>
</Base>

<script>
  import { lifePath, lifePathCard, parseDate } from "../../lib/numerology.ts";
  import { cardResult, el, readConfig } from "../../lib/cardView.ts";
  import type { MeaningCard } from "../../lib/data.ts";

  for (const root of document.querySelectorAll<HTMLElement>("[data-life]")) {
    const cfg = readConfig<{ base: string; deck: MeaningCard[]; text: Record<string, string> }>(root);
    const out = root.querySelector<HTMLElement>("[data-out]")!;
    root.querySelector<HTMLInputElement>("[data-bd]")!.max = new Date().toISOString().slice(0, 10);
    root.querySelector<HTMLButtonElement>("[data-go]")!.onclick = () => {
      const d = parseDate(root.querySelector<HTMLInputElement>("[data-bd]")!.value);
      if (!d) {
        out.replaceChildren(el("p", "center muted", "Pick your birthday first."));
        return;
      }
      const n = lifePath(...d);
      const c = cfg.deck.find((x) => x.n === lifePathCard(n))!;
      const head = el("div", "center");
      head.append(el("p", "eyebrow", "Your life path number"), el("p", "big-number", String(n)), el("p", "", cfg.text[n]!));
      out.replaceChildren(head, cardResult(c, cfg.base, `The card for ${n}`, c.core));
    };
  }
</script>
