---
import Base from "../../layouts/Base.astro";
import Pairing from "../../components/Pairing.astro";
import { BASE } from "../../config.ts";
---
<Base
  title="Elemental dignities in tarot: free checker · ShenTarot"
  description="Check the elemental dignities of two or three tarot cards. See which cards strengthen or weaken each other by Fire, Water, Air and Earth. Free, in your browser."
  path="tools/elements"
  crumbs={[["Free tools", "tools"], ["Elemental dignities", "tools/elements"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Free tool</p>
    <h1>Elemental dignities</h1>
    <p class="lead">
      A method from the Golden Dawn tradition, often used instead of reversals. Each card has an element, and cards
      next to each other strengthen or weaken one another. Pick a line of two or three cards to check them.
    </p>
  </header>
  <Pairing mode="elements" slots={["Left card", "Middle card", "Right card"]} />
  <section class="narrow" style="margin:3rem auto 0">
    <h2>How it works</h2>
    <ul>
      <li><b>Suits:</b> Wands are Fire, Cups are Water, Swords are Air and Pentacles are Earth.</li>
      <li><b>Major Arcana</b> take the element of their traditional zodiac sign or element. Cards linked to a planet have no single element here and count as neutral.</li>
      <li><b>Same element:</b> the cards strengthen each other.</li>
      <li><b>Opposites</b> (Fire and Water, Air and Earth) weaken each other.</li>
      <li><b>Other pairs</b> support each other. Some readers count Fire with Earth, and Air with Water, as neutral instead.</li>
      <li><b>In a line of three</b>, the middle card is judged by both neighbours. A card between two friends is strong; a card between two opposites is weak.</li>
    </ul>
    <p class="muted">Each card's element is listed on its <a href={`${BASE}cards`}>meaning page</a>. To read two cards together, try <a href={`${BASE}tools/combinations`}>card combinations</a>.</p>
  </section>
</Base>
