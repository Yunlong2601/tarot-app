---
import Base from "../../layouts/Base.astro";
import Reader from "../../components/Reader.astro";
import { BASE } from "../../config.ts";
import { SPREADS } from "../../lib/data.ts";
---
<Base
  title="Yes or No tarot: free three-card reading · ShenTarot"
  description="Ask a yes or no question and draw three tarot cards. Upright cards lean yes, reversed lean no, and the middle card counts double. Free, in your browser."
  path="tools/yes-no"
  crumbs={[["Free tools", "tools"], ["Yes or No tarot", "tools/yes-no"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Free tool</p>
    <h1>Yes or No tarot</h1>
    <p class="lead">
      Hold a clear yes or no question in mind and draw three cards. Upright cards lean yes, reversed cards lean no, and
      the middle card counts double. Each card comes up reversed half the time, so neither answer is favoured.
    </p>
  </header>
  <Reader positions={SPREADS.yes_no.positions} mode="yesno" reversals={0.5} button="Draw three cards" />
  <section class="narrow" style="margin:3rem auto 0">
    <h2>How to ask a good yes or no question</h2>
    <ul>
      <li>Ask about one thing, and about something you can act on: "Should I apply for the design job?" works better than "Will my life get better?"</li>
      <li>Ask once. Drawing again for the same question just adds noise.</li>
      <li>Read the three meanings, not only the lean. They show what could tip the answer the other way.</li>
    </ul>
    <p class="muted">For entertainment and self-reflection. For health, money or legal questions, talk to a professional. See also the <a href={`${BASE}spreads/yes-no`}>Yes or No spread</a>.</p>
  </section>
</Base>
