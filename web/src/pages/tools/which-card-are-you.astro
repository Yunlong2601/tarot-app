---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { meaningDeck } from "../../lib/data.ts";

const courts = meaningDeck.filter((c) => c.suit !== null && c.n === null);
const config = JSON.stringify({ base: BASE, deck: courts });
// Each answer scores a suit (element) or a rank (how you act).
const questions: [string, [string, string][]][] = [
  ["On a free afternoon, you would rather…", [["wands", "Start something new"], ["cups", "Spend it with someone close"], ["swords", "Read, plan or debate"], ["pentacles", "Make or fix something"]]],
  ["Friends come to you for…", [["wands", "Energy and a push"], ["cups", "Comfort and a listening ear"], ["swords", "Honest advice"], ["pentacles", "Practical help"]]],
  ["What matters most to you?", [["wands", "Passion"], ["cups", "Love"], ["swords", "Truth"], ["pentacles", "Security"]]],
  ["When something new comes along, you…", [["page", "Get curious and ask questions"], ["knight", "Jump straight in"], ["queen", "Feel your way in slowly"], ["king", "Take charge of it"]]],
  ["In a group, you are usually the one who…", [["page", "Learns and brings fresh ideas"], ["knight", "Gets things moving"], ["queen", "Looks after everyone"], ["king", "Makes the final call"]]],
  ["Your biggest strength is…", [["page", "Openness"], ["knight", "Drive"], ["queen", "Understanding"], ["king", "Steadiness"]]],
];
---
<Base
  title="Which tarot card are you? A free six-question quiz · ShenTarot"
  description="Answer six quick questions to find the tarot court card that matches your personality, from the Page of Wands to the King of Pentacles."
  path="tools/which-card-are-you"
  crumbs={[["Free tools", "tools"], ["Which card are you?", "tools/which-card-are-you"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Quiz</p>
    <h1>Which tarot card are you?</h1>
    <p class="lead">Six quick questions match you to one of the 16 court cards: your suit shows what drives you, and your rank shows how you act. Your answers stay on this page.</p>
  </header>
  <form class="quiz" data-quiz style="max-width:40rem;margin:0 auto">
    <script type="application/json" data-config set:html={config.replace(/</g, "\\u003c")} />
    {questions.map(([q, opts], i) => (
      <fieldset>
        <legend>{q}</legend>
        {opts.map(([v, label]) => <label><input type="radio" name={`q${i}`} value={v} required /> {label}</label>)}
      </fieldset>
    ))}
    <p class="center"><button class="btn btn-gold" type="submit">See my card</button></p>
  </form>
  <div class="results" data-out aria-live="polite"></div>
</Base>

<script>
  import { cardResult, el, readConfig } from "../../lib/cardView.ts";
  import type { MeaningCard } from "../../lib/data.ts";

  const SUITS = ["wands", "cups", "swords", "pentacles"];
  const RANKS = ["page", "knight", "queen", "king"];
  const form = document.querySelector<HTMLFormElement>("[data-quiz]")!;
  const out = document.querySelector<HTMLElement>("[data-out]")!;
  const cfg = readConfig<{ base: string; deck: MeaningCard[] }>(form);

  // Ties go to the later answer, so the last question in each half breaks them.
  const pick = (vals: string[], from: string[]) => {
    const count = new Map<string, number>();
    let best = vals[vals.length - 1]!;
    for (const v of vals) count.set(v, (count.get(v) ?? 0) + 1);
    for (const v of from) if ((count.get(v) ?? 0) > (count.get(best) ?? 0)) best = v;
    return best;
  };

  function show(id: string) {
    const c = cfg.deck.find((x) => x.id === id);
    if (!c) return;
    const share = el("button", "btn btn-ghost btn-sm", "Copy link to my result");
    share.type = "button";
    const url = new URL(location.href);
    url.search = `?card=${c.slug}`;
    share.onclick = () => navigator.clipboard?.writeText(url.href).then(() => (share.textContent = "Link copied"));
    const p = el("p", "center");
    p.append(share);
    out.replaceChildren(cardResult(c, cfg.base, "You are", c.core), p);
    out.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  form.onsubmit = (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const vals = [0, 1, 2, 3, 4, 5].map((i) => String(data.get(`q${i}`)));
    show(`${pick(vals.slice(0, 3), SUITS)}_${pick(vals.slice(3), RANKS)}`);
  };

  const shared = new URLSearchParams(location.search).get("card");
  if (shared) show(shared.replace(/-/g, "_"));
</script>
