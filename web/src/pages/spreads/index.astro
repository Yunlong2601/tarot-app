---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../config.ts";
import { APP_SPREADS, SPREADS, plural, slug, spreadIds, titleCase } from "../../lib/data.ts";

const cats = ["classics", "love", "career", "growth"];
---
<Base
  title="Tarot spreads: layouts and what each position means · ShenTarot"
  description="Tarot spreads for love, career, decisions and yes or no questions, with every position explained."
  path="spreads"
  crumbs={[["Spreads", "spreads"]]}
>
  <header class="page-head center">
    <p class="eyebrow">Layouts</p>
    <h1>Tarot spreads</h1>
    <p class="lead">What each spread is for and what every position means, from one card to the Celtic Cross.</p>
  </header>
  <nav class="pills" style="justify-content:center" aria-label="Categories">
    {cats.map((cat) => <a href={`#${cat}`}>{titleCase(cat)}</a>)}
  </nav>
  {cats.map((cat) => (
    <section>
      <h2 class="group-title" id={cat}>{titleCase(cat)}</h2>
      <div class="grid-3">
        {spreadIds.filter((id) => SPREADS[id].category === cat).map((id) => (
          <a class="panel spread-card" href={`${BASE}spreads/${slug(id)}`}>
            <div class="layout" aria-hidden="true">{SPREADS[id].positions.map(() => <i />)}</div>
            <p class="count">{plural(SPREADS[id].positions.length, "card")}</p>
            <h3>{SPREADS[id].name}</h3>
            <p>{APP_SPREADS[id].blurb}</p>
            <span class="link-arrow">See the positions</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
