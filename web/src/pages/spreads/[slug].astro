---
import Base from "../../layouts/Base.astro";
import Reader from "../../components/Reader.astro";
import { BASE } from "../../config.ts";
import { APP_SPREADS, SPREADS, plural, slug, spreadIds, titleCase, type SpreadId } from "../../lib/data.ts";
import { TOPICS } from "../../lib/topics.ts";

export function getStaticPaths() {
  return spreadIds.map((id) => ({ params: { slug: slug(id) }, props: { id } }));
}
const { id } = Astro.props as { id: SpreadId };
const s = SPREADS[id];
const count = plural(s.positions.length, "card");
const n = s.positions.length;
// The topic pages that suggest this spread, and their sample questions.
const topics = TOPICS.filter((t) => t.spreads.includes(id));
const questions = [...new Set(topics.flatMap((t) => t.questions))];
const related = spreadIds.filter((x) => x !== id && SPREADS[x].category === s.category).slice(0, 3);
const faq: [string, string][] = [
  [`How many cards are in the ${s.name} spread?`, `${count}: ${s.positions.map((p, i) => `${i + 1}. ${p}`).join("; ")}.`],
  [`What is the ${s.name} spread for?`, APP_SPREADS[id].blurb],
  ...(questions.length ? [[`What questions suit the ${s.name} spread?`, questions.join(" ")] as [string, string]] : []),
];
const jsonLd = [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }];
---
<Base
  title={`${s.name} tarot spread: ${count} · ShenTarot`}
  description={`${s.name}: a ${s.positions.length}-card tarot spread. ${APP_SPREADS[id].blurb}`}
  path={`spreads/${slug(id)}`}
  crumbs={[["Spreads", "spreads"], [s.name, `spreads/${slug(id)}`]]}
  jsonLd={jsonLd}
>
  <ol class="crumbs" style="margin-top:2rem">
    <li><a href={`${BASE}`}>Home</a></li>
    <li><a href={`${BASE}spreads`}>Spreads</a></li>
    <li><a href={`${BASE}spreads#${s.category}`}>{titleCase(s.category)}</a></li>
  </ol>
  <header class="page-head" style="padding-top:0">
    <p class="eyebrow">{count} · {titleCase(s.category)}</p>
    <h1>{s.name}</h1>
    <p class="lead">{APP_SPREADS[id].blurb}</p>
  </header>
  <h2 style="margin:1rem 0 1.4rem">The positions</h2>
  <ol class="positions">{s.positions.map((p) => <li>{p}</li>)}</ol>
  {APP_SPREADS[id].source && <p class="muted" style="margin-top:1.5rem">Source: {APP_SPREADS[id].source}</p>}
  {questions.length > 0 && (
    <>
      <h2 style="margin:2.5rem 0 1rem">Best for questions like</h2>
      <ul class="questions">{questions.map((q) => <li>{q}</li>)}</ul>
      <p class="muted">From {topics.map((t, i) => <>{i > 0 && (i === topics.length - 1 ? " and " : ", ")}<a href={`${BASE}topics/${t.slug}`}>{t.title.toLowerCase()}</a></>)}.</p>
    </>
  )}
  <h2 style="margin:2.5rem 0 1rem">How to read it</h2>
  <ol class="steps-list">
    <li>Hold one clear question in mind{id === "yes_no" ? ", worded so it can be answered yes or no" : ""}.</li>
    <li>Shuffle, then lay out {count} in order{n > 1 ? `, from position 1 to ${n}` : ""}.</li>
    <li>Read each card for its position: the same card means something different as {n > 1 ? `"${s.positions[0]}" than as "${s.positions[n - 1]}"` : "a single answer than inside a bigger spread"}.</li>
    {n > 1 && <li>Then read the cards together: the story they tell, which suits lead and how many are Major Arcana. The reader below shows this for you.</li>}
  </ol>
  <section class="section" id="try" style="padding-bottom:0">
    <div class="section-head">
      <p class="ornament">✦</p>
      <h2>Try this spread</h2>
      <p>Draw the cards here and read each position. Nothing is sent anywhere.</p>
    </div>
    <Reader positions={s.positions} mode={id === "yes_no" ? "yesno" : "spread"} reversals={id === "yes_no" ? 0.5 : 0.25} />
  </section>
  {related.length > 0 && (
    <section class="section" style="padding-bottom:0">
      <h2>Related spreads</h2>
      <div class="grid-3">
        {related.map((r) => (
          <a class="panel spread-card" href={`${BASE}spreads/${slug(r)}`}>
            <h3>{SPREADS[r].name}</h3>
            <p class="muted">{plural(SPREADS[r].positions.length, "card")}</p>
            <p>{APP_SPREADS[r].blurb}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  <section class="section" style="padding-bottom:0">
    <h2 class="center">Questions about the {s.name} spread</h2>
    <div class="faq">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
