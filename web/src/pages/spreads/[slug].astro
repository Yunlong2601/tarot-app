---
import Base from "../../layouts/Base.astro";
import Reader from "../../components/Reader.astro";
import { BASE } from "../../config.ts";
import { APP_SPREADS, SPREADS, plural, slug, spreadIds, titleCase, type SpreadId } from "../../lib/data.ts";

export function getStaticPaths() {
  return spreadIds.map((id) => ({ params: { slug: slug(id) }, props: { id } }));
}
const { id } = Astro.props as { id: SpreadId };
const s = SPREADS[id];
const count = plural(s.positions.length, "card");
---
<Base
  title={`${s.name} tarot spread: ${count} · ShenTarot`}
  description={`${s.name}: a ${s.positions.length}-card tarot spread. ${APP_SPREADS[id].blurb}`}
  path={`spreads/${slug(id)}`}
  crumbs={[["Spreads", "spreads"], [s.name, `spreads/${slug(id)}`]]}
>
  <ol class="crumbs" style="margin-top:2rem">
    <li><a href={`${BASE}`}>Home</a></li>
    <li><a href={`${BASE}spreads`}>Spreads</a></li>
    <li><a href={`${BASE}spreads#${s.category}`}>{titleCase(s.category)}</a></li>
  </ol>
  <header class="page-head" style="padding-top:0">
    <p class="eyebrow">{count} · {titleCase(s.category)}</p>
    <h1>{s.name}</h1>
    <p class="lead">{APP_SPREADS[id].blurb}</p>
  </header>
  <h2 style="margin:1rem 0 1.4rem">The positions</h2>
  <ol class="positions">{s.positions.map((p) => <li>{p}</li>)}</ol>
  {APP_SPREADS[id].source && <p class="muted" style="margin-top:1.5rem">Source: {APP_SPREADS[id].source}</p>}
  <section class="section" style="padding-bottom:0">
    <div class="section-head">
      <p class="ornament">✦</p>
      <h2>Try this spread</h2>
      <p>Draw the cards here and read each position. Nothing is sent anywhere.</p>
    </div>
    <Reader positions={s.positions} mode={id === "yes_no" ? "yesno" : "spread"} reversals={id === "yes_no" ? 0.5 : 0.25} />
  </section>
</Base>
