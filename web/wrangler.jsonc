// Cloudflare hosting for shentarot.com. Deploy with `npm run deploy` after
// `npx wrangler login`. Pages are static files from dist/, served at their
// exact .html paths (html_handling "none") so addresses match the canonical
// links and the sitemap. Only /s/* (shared readings) runs the small worker,
// which hands them to the backend Worker (shentarot-api) through a service
// binding, so deploy the backend first.
{
  "name": "shentarot-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": ["/s/*"]
  },
  "services": [{ "binding": "API", "service": "shentarot-api" }],
  "routes": [{ "pattern": "shentarot.com", "custom_domain": true }]
}
