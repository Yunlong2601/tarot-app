{"openapi":"3.1.0","info":{"title":"ShenTarot App API — core operations","version":"1.0.0","description":"Discovery of the existing mobile-app API. This specification covers health, installation, readings and follow-ups; it is not an exhaustive inventory of account, credit, sharing, webhook or administrative operations. Requires the normal app install token and applicable entitlements. No general-purpose third-party token issuance or delegated account access is offered. Entertainment and self-reflection only."},"servers":[{"url":"https://shentarot-api.shentech.workers.dev"}],"externalDocs":{"url":"https://shentarot.com/api/docs"},"paths":{"/health":{"get":{"operationId":"health","summary":"Service liveness","responses":{"200":{"description":"Worker is responding; does not attest upstream AI availability","content":{"application/json":{"schema":{"type":"object","required":["ok"],"properties":{"ok":{"type":"boolean","const":true}}}}}}}}},"/v1/install":{"post":{"operationId":"install","summary":"Obtain a short-lived app-install token","description":"For the mobile app. Issuance is controlled by deployment attestation/beta configuration; discovery is not permission to create installations. Returns 501 when attestation is not configured and un-attested installs are disabled.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["installId"],"properties":{"installId":{"type":"string","format":"uuid"}}}}}},"responses":{"200":{"description":"Install token","content":{"application/json":{"schema":{"type":"object","required":["token"],"properties":{"token":{"type":"string"}}}}}},"400":{"description":"Invalid input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or daily limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"Attestation not configured","content":{"application/json":{"schema":{"$ref":"#/compon