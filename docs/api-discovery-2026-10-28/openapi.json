{"type":"string"}}},{"$ref":"#/components/schemas/CareResponse"}]}}}},"400":{"description":"Invalid input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or expired install token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Premium or credits required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request declined","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or daily limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Service temporarily unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"securitySchemes":{"installBearer":{"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"Short-lived app-install token issued by the existing app flow."}},"schemas":{"Card":{"type":"object","required":["id","reversed"],"properties":{"id":{"type":"string","description":"Existing ShenTarot card id, such as major_19_sun."},"reversed":{"type":"boolean"}}},"ReadingRequest":{"type":"object","required":["spread","cards"],"properties":{"spread":{"type":"string","description":"A supported spread id, for example single, three or celtic. Card count must match that spread."},"cards":{"type":"array","minItems":1,"maxItems":10,"items":{"$ref":"#/components/schemas/Card"},"description":"Known, unique card ids in spread-position order."},"question":{"type":["string","null"],"maxLength":300},"impression":{"type":["string","null"],"maxLength":300}}},"FollowupRequest":{"type":"object","required":["spread","cards","reading","followup"],"properties":{"spread":{"type":"string","description":"A supported spread id, for example single, three or celtic. Card count must match that spread."},"cards":{"type":"array","minItems":1,"maxItems":10,"items":{"$ref":"#/components/schemas/Card"},"description":"Known, unique card ids in spread-position order."},"question":{"type":["string","null"],"maxLength":300},"impression":{"type":["string","null"],"maxLength":300},"reading":{"type":"string","minLength":1,"maxLength":4000},"followup":{"type":"string","minLength":1,"maxLength":300},"clarifier":{"anyOf":[{"$ref":"#/components/schemas/Card"},{"type":"null"}],"description":"Optional additional card, distinct from the spread."}}},"ReadingResponse":{"type":"object","required":["reading","disclaimer"],"properties":{"reading":{"type":"string"},"disclaimer":{"type":"string"},"fallback":{"type":"boolean"},"structured":{"type":["object","null"],"additionalProperties":true}}},"CareResponse":{"type":"object","required":["crisis","message"],"properties":{"crisis":{"type":"boolean","const":true},"message":{"type":"string"}}},"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"string"},"detail":{"type":"string"}},"additionalProperties":true}}}}